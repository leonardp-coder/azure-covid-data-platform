CREATE OR ALTER PROCEDURE analytics.usp_load_covid_warehouse
    @PipelineName NVARCHAR(200) = N'pl_covid_gold_to_sql',
    @RunId NVARCHAR(100) = NULL
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    DECLARE @ExecutionId BIGINT;
    DECLARE @SourceCount BIGINT;
    DECLARE @InsertedCount BIGINT;
    DECLARE @ErrorMessage NVARCHAR(MAX);

    BEGIN TRY

        -- 1. Start pipeline execution audit
        INSERT INTO audit.pipeline_execution_log
        (
            pipeline_name,
            run_id,
            start_time,
            status
        )
        VALUES
        (
            @PipelineName,
            @RunId,
            SYSUTCDATETIME(),
            'Running'
        );

        SET @ExecutionId = SCOPE_IDENTITY();

        BEGIN TRANSACTION;

        -- 2. Validate dimension data

        IF EXISTS (
            SELECT 1 FROM staging.dim_country
            WHERE country_key IS NULL OR country_name IS NULL
        )
            THROW 50001, 'Invalid records found in staging.dim_country.', 1;

        IF EXISTS (
            SELECT country_key
            FROM staging.dim_country
            GROUP BY country_key
            HAVING COUNT(*) > 1
        )
            THROW 50002, 'Duplicate country keys found.', 1;

        IF EXISTS (
            SELECT 1 FROM staging.dim_date
            WHERE date_key IS NULL OR full_date IS NULL
        )
            THROW 50003, 'Invalid records found in staging.dim_date.', 1;

        IF EXISTS (
            SELECT date_key
            FROM staging.dim_date
            GROUP BY date_key
            HAVING COUNT(*) > 1
        )
            THROW 50004, 'Duplicate date keys found.', 1;

        IF EXISTS (
            SELECT full_date
            FROM staging.dim_date
            GROUP BY full_date
            HAVING COUNT(*) > 1
        )
            THROW 50005, 'Duplicate full dates found.', 1;

        IF EXISTS (
            SELECT 1 FROM staging.dim_age_group
            WHERE age_group_key IS NULL
        )
            THROW 50006, 'Invalid records found in staging.dim_age_group.', 1;

        IF EXISTS (
            SELECT age_group_key
            FROM staging.dim_age_group
            GROUP BY age_group_key
            HAVING COUNT(*) > 1
        )
            THROW 50007, 'Duplicate age group keys found.', 1;


        -- 3. Validate fact table business keys

        IF EXISTS (
            SELECT 1 FROM staging.fact_covid_daily
            WHERE date_key IS NULL OR geography_name IS NULL
        )
            THROW 50008, 'Invalid records found in staging.fact_covid_daily.', 1;

        IF EXISTS (
            SELECT geography_name, date_key
            FROM staging.fact_covid_daily
            GROUP BY geography_name, date_key
            HAVING COUNT(*) > 1
        )
            THROW 50009, 'Duplicate COVID daily business keys found.', 1;

        IF EXISTS (
            SELECT 1 FROM staging.fact_hospital_daily
            WHERE date_key IS NULL
               OR country_name IS NULL
               OR indicator IS NULL
        )
            THROW 50010, 'Invalid records found in staging.fact_hospital_daily.', 1;

        IF EXISTS (
            SELECT country_name, date_key, indicator
            FROM staging.fact_hospital_daily
            GROUP BY country_name, date_key, indicator
            HAVING COUNT(*) > 1
        )
            THROW 50011, 'Duplicate hospital daily business keys found.', 1;

        IF EXISTS (
            SELECT 1 FROM staging.fact_hospital_weekly
            WHERE country_name IS NULL
               OR year_week IS NULL
               OR iso_year IS NULL
               OR iso_week IS NULL
               OR indicator IS NULL
        )
            THROW 50012, 'Invalid records found in staging.fact_hospital_weekly.', 1;

        IF EXISTS (
            SELECT country_name, year_week, indicator
            FROM staging.fact_hospital_weekly
            GROUP BY country_name, year_week, indicator
            HAVING COUNT(*) > 1
        )
            THROW 50013, 'Duplicate hospital weekly business keys found.', 1;

        IF EXISTS (
            SELECT 1 FROM staging.fact_population_age
            WHERE age_group_key IS NULL
               OR geo_code IS NULL
               OR geography_type IS NULL
               OR year IS NULL
        )
            THROW 50014, 'Invalid records found in staging.fact_population_age.', 1;

        IF EXISTS (
            SELECT geo_code, year, age_group_key
            FROM staging.fact_population_age
            GROUP BY geo_code, year, age_group_key
            HAVING COUNT(*) > 1
        )
            THROW 50015, 'Duplicate population age business keys found.', 1;


        -- 4. Validate foreign-key references

        IF EXISTS (
            SELECT 1
            FROM staging.fact_covid_daily f
            LEFT JOIN staging.dim_country d
                ON f.country_key = d.country_key
            WHERE f.country_key IS NOT NULL
              AND d.country_key IS NULL
        )
            THROW 50016, 'Orphan country keys in fact_covid_daily.', 1;

        IF EXISTS (
            SELECT 1
            FROM staging.fact_covid_daily f
            LEFT JOIN staging.dim_date d
                ON f.date_key = d.date_key
            WHERE d.date_key IS NULL
        )
            THROW 50017, 'Orphan date keys in fact_covid_daily.', 1;

        IF EXISTS (
            SELECT 1
            FROM staging.fact_hospital_daily f
            LEFT JOIN staging.dim_country d
                ON f.country_key = d.country_key
            WHERE f.country_key IS NOT NULL
              AND d.country_key IS NULL
        )
            THROW 50018, 'Orphan country keys in fact_hospital_daily.', 1;

        IF EXISTS (
            SELECT 1
            FROM staging.fact_hospital_daily f
            LEFT JOIN staging.dim_date d
                ON f.date_key = d.date_key
            WHERE d.date_key IS NULL
        )
            THROW 50019, 'Orphan date keys in fact_hospital_daily.', 1;

        IF EXISTS (
            SELECT 1
            FROM staging.fact_hospital_weekly f
            LEFT JOIN staging.dim_country d
                ON f.country_key = d.country_key
            WHERE f.country_key IS NOT NULL
              AND d.country_key IS NULL
        )
            THROW 50020, 'Orphan country keys in fact_hospital_weekly.', 1;

        IF EXISTS (
            SELECT 1
            FROM staging.fact_population_age f
            LEFT JOIN staging.dim_country d
                ON f.country_key = d.country_key
            WHERE f.country_key IS NOT NULL
              AND d.country_key IS NULL
        )
            THROW 50021, 'Orphan country keys in fact_population_age.', 1;

        IF EXISTS (
            SELECT 1
            FROM staging.fact_population_age f
            LEFT JOIN staging.dim_age_group d
                ON f.age_group_key = d.age_group_key
            WHERE d.age_group_key IS NULL
        )
            THROW 50022, 'Orphan age group keys in fact_population_age.', 1;


        -- 5. Clear existing analytics data
        -- Delete facts before dimensions because of foreign keys.

        DELETE FROM analytics.fact_population_age;
        DELETE FROM analytics.fact_hospital_weekly;
        DELETE FROM analytics.fact_hospital_daily;
        DELETE FROM analytics.fact_covid_daily;

        DELETE FROM analytics.dim_age_group;
        DELETE FROM analytics.dim_date;
        DELETE FROM analytics.dim_country;


        -- 6. Load dimensions first

        SELECT @SourceCount = COUNT_BIG(*) FROM staging.dim_country;

        INSERT INTO analytics.dim_country
        (
            country_key, country_name, country_code_2_digit,
            country_code_3_digit, continent, population
        )
        SELECT
            country_key, country_name, country_code_2_digit,
            country_code_3_digit, continent, population
        FROM staging.dim_country;

        SET @InsertedCount = @@ROWCOUNT;

        INSERT INTO audit.load_control
        (table_name, source_count, inserted_count, updated_count,
         rejected_count, load_status)
        VALUES
        ('dim_country', @SourceCount, @InsertedCount, 0, 0, 'Succeeded');


        SELECT @SourceCount = COUNT_BIG(*) FROM staging.dim_date;

        INSERT INTO analytics.dim_date
        (
            full_date, date_key, year, quarter, month,
            month_name, day, day_name, week_of_year, day_of_week
        )
        SELECT
            full_date, date_key, year, quarter, month,
            month_name, day, day_name, week_of_year, day_of_week
        FROM staging.dim_date;

        SET @InsertedCount = @@ROWCOUNT;

        INSERT INTO audit.load_control
        (table_name, source_count, inserted_count, updated_count,
         rejected_count, load_status)
        VALUES
        ('dim_date', @SourceCount, @InsertedCount, 0, 0, 'Succeeded');


        SELECT @SourceCount = COUNT_BIG(*) FROM staging.dim_age_group;

        INSERT INTO analytics.dim_age_group
        (age_group_key, age_indicator, age_group)
        SELECT age_group_key, age_indicator, age_group
        FROM staging.dim_age_group;

        SET @InsertedCount = @@ROWCOUNT;

        INSERT INTO audit.load_control
        (table_name, source_count, inserted_count, updated_count,
         rejected_count, load_status)
        VALUES
        ('dim_age_group', @SourceCount, @InsertedCount, 0, 0, 'Succeeded');


        -- 7. Load fact tables

        SELECT @SourceCount = COUNT_BIG(*) FROM staging.fact_covid_daily;

        INSERT INTO analytics.fact_covid_daily
        (
            country_key, date_key, country_code, geography_name,
            continent, geography_type, confirmed_cases,
            new_deaths, rate_14_day, population
        )
        SELECT
            country_key, date_key, country_code, geography_name,
            continent, geography_type, confirmed_cases,
            new_deaths, rate_14_day, population
        FROM staging.fact_covid_daily;

        SET @InsertedCount = @@ROWCOUNT;

        INSERT INTO audit.load_control
        (table_name, source_count, inserted_count, updated_count,
         rejected_count, load_status)
        VALUES
        ('fact_covid_daily', @SourceCount, @InsertedCount, 0, 0, 'Succeeded');


        SELECT @SourceCount = COUNT_BIG(*) FROM staging.fact_hospital_daily;

        INSERT INTO analytics.fact_hospital_daily
        (
            country_key, date_key, country_name,
            indicator, value, source
        )
        SELECT
            country_key, date_key, country_name,
            indicator, value, source
        FROM staging.fact_hospital_daily;

        SET @InsertedCount = @@ROWCOUNT;

        INSERT INTO audit.load_control
        (table_name, source_count, inserted_count, updated_count,
         rejected_count, load_status)
        VALUES
        ('fact_hospital_daily', @SourceCount, @InsertedCount, 0, 0, 'Succeeded');


        SELECT @SourceCount = COUNT_BIG(*) FROM staging.fact_hospital_weekly;

        INSERT INTO analytics.fact_hospital_weekly
        (
            country_key, country_name, year_week,
            iso_year, iso_week, indicator, value, source
        )
        SELECT
            country_key, country_name, year_week,
            iso_year, iso_week, indicator, value, source
        FROM staging.fact_hospital_weekly;

        SET @InsertedCount = @@ROWCOUNT;

        INSERT INTO audit.load_control
        (table_name, source_count, inserted_count, updated_count,
         rejected_count, load_status)
        VALUES
        ('fact_hospital_weekly', @SourceCount, @InsertedCount, 0, 0, 'Succeeded');


        SELECT @SourceCount = COUNT_BIG(*) FROM staging.fact_population_age;

        INSERT INTO analytics.fact_population_age
        (
            country_key, age_group_key, geo_code,
            geography_type, year, population_percentage
        )
        SELECT
            country_key, age_group_key, geo_code,
            geography_type, year, population_percentage
        FROM staging.fact_population_age;

        SET @InsertedCount = @@ROWCOUNT;

        INSERT INTO audit.load_control
        (table_name, source_count, inserted_count, updated_count,
         rejected_count, load_status)
        VALUES
        ('fact_population_age', @SourceCount, @InsertedCount, 0, 0, 'Succeeded');


        -- 8. Commit the complete load

        COMMIT TRANSACTION;

        UPDATE audit.pipeline_execution_log
        SET
            end_time = SYSUTCDATETIME(),
            status = 'Succeeded',
            error_message = NULL
        WHERE execution_id = @ExecutionId;

    END TRY

    BEGIN CATCH

        IF XACT_STATE() <> 0
            ROLLBACK TRANSACTION;

        SET @ErrorMessage = ERROR_MESSAGE();

        IF @ExecutionId IS NOT NULL
        BEGIN
            UPDATE audit.pipeline_execution_log
            SET
                end_time = SYSUTCDATETIME(),
                status = 'Failed',
                error_message = @ErrorMessage
            WHERE execution_id = @ExecutionId;
        END;

        THROW;

    END CATCH
END;
GO
